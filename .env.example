# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Database (Supabase: use a string do pooler, ex. postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/icaseweb_ebd
# SSL: ligado com NODE_ENV=production ou PGSSL=require; PGSSL=disable desliga.
PGSSL=disable
# Tamanho do pool (default: 20 local, 10 em produção)
# PG_POOL_MAX=10

# Session (obrigatório em produção; use um valor longo e aleatório)
SESSION_SECRET=sua_chave_secreta_muito_longa_e_aleatoria_aqui

# Seed do admin inicial (npm run seed) — defaults: admin@ebd.com / admin123 / Administrador
# ADMIN_EMAIL=admin@ebd.com
# ADMIN_SENHA=troque-esta-senha
# ADMIN_NOME=Administrador
